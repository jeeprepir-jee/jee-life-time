{
  "manifest_version": 3,
  "name": "Jee Lifetime Reel Companion",
  "version": "0.1.1",
  "description": "Detects supported outgoing Instagram Reel links and sends selected links to your Jee Lifetime library.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "Jee Lifetime Reel Companion"},
  "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}